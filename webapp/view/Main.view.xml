<mvc:View
    xmlns:rowmodes="sap.ui.table.rowmodes"
    controllerName="contractmanagement.contractmanagement.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:form="sap.ui.layout.form"
    xmlns:uxap="sap.uxap"
    xmlns:f="sap.f"
    xmlns:t="sap.ui.table"
    xmlns:l="sap.ui.layout"
    xmlns:core="sap.ui.core"
>
    <f:DynamicPage
        showFooter="true"
        headerExpanded="true"
        headerPinned="true"
        fitContent="true"
    >
        <f:title>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:heading>
                    <Title text="{i18n>title}" />
                </uxap:heading>
            </uxap:ObjectPageDynamicHeaderTitle>
        </f:title>
        <f:content>
            <FlexBox
                direction="Column"
                height="100%"
                gap="1rem"
            >
                <Panel
                    expandable="true"
                    expanded="true"
                    headerText="{i18n>createOffer}"
                    stickyHeader="true"
                >
                    <layoutData>
                        <FlexItemData
                            growFactor="0"
                            shrinkFactor="0"
                        />
                    </layoutData>
                    <form:SimpleForm
                        editable="true"
                        layout="ColumnLayout"
                        labelSpanXL="2"
                        labelSpanL="3"
                        labelSpanM="3"
                        labelSpanS="12"
                        emptySpanXL="2"
                        emptySpanL="1"
                        emptySpanM="1"
                        emptySpanS="0"
                        columnsXL="2"
                        columnsL="2"
                        columnsM="2"
                    >
                        <form:content>
                            <!-- <core:Title text="{i18n>createOffer}"/> -->
                            <Label
                                text="{i18n>type}"
                                labelFor="iptType"
                                required="true"
                            />
                            <Input
                                id="iptType"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oType/Name} {mContractManagement>/header/oType/Description}"
                                valueHelpRequest="onOpenPopUpType"
                            />
                            <Label
                                text="{i18n>contractType}"
                                labelFor="iptContractType"
                                required="true"
                            />
                            <Input
                                id="iptContractType"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oContractType/Name} {mContractManagement>/header/oContractType/Description}"
                                valueHelpRequest="onOpenPopUpContractType"
                            />
                            <Label
                                text="{i18n>offerType}"
                                labelFor="iptOfferType"
                                required="true"
                            />
                            <Input
                                id="iptOfferType"
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oOfferType/Auart} {mContractManagement>/header/oOfferType/Bezei}"
                                valueHelpRequest="onOpenPopUpOfferType"
                            />
                            <Label
                                text="{i18n>salesOrganization}"
                                required="true"
                            />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oSalesOrganization/Vkorg} {mContractManagement>/header/oSalesOrganization/Vtext}"
                                valueHelpRequest="onOpenPopUpSalesOrganization"
                            />
                            <Label
                                text="{i18n>channel}"
                                required="true"
                            />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oChannel/Vtweg} {mContractManagement>/header/oChannel/Vtext}"
                                valueHelpRequest="onOpenPopUpChannel"
                            />
                            <Label text="{i18n>sector}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oSector/Spart} {mContractManagement>/header/oSector/Vtext}"
                                valueHelpRequest="onOpenPopUpSector"
                            />
                            <Label text="{i18n>salesOffice}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oSalesOffice/Office} {mContractManagement>/header/oSalesOffice/Description}"
                                valueHelpRequest="onOpenPopUpSalesOffice"
                            />
                            <Label text="{i18n>salesGroup}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oSalesGroup/Group} {mContractManagement>/header/oSalesGroup/Description}"
                                valueHelpRequest="onOpenPopUpSalesGroup"
                            />
                            <Label text="{i18n>customerOrder}" />
                            <Input
                                value="{mContractManagement>/header/customerOrder}"
                                maxLength="35"
                            />

                            <!-- <core:Title/> -->
                            <Label text="{i18n>orderDate}" />
                            <DatePicker
                                dateValue="{mContractManagement>/header/orderDate}"
                            />
                            <Label text="{i18n>requester}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oRequester/CustomerCode} {mContractManagement>/header/oRequester/Name1}"
                                valueHelpRequest="onOpenPopUpRequester"
                            />
                            <!-- se comento lo de SHIPTO o destinatario esto es para lo del 1000 y lo del 8000mil  -->
                            <Label text="{i18n>shipto}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oShipTo/CustomerCode} {mContractManagement>/header/oShipTo/Name1}"
                                valueHelpRequest="onOpenPopUpShipTo"
                            />

                            <!-- Miguel Angel Inicio: Método de pago -->
                            <Label text="{i18n>paymentMethod}" />
                            <Select
                                id="slPaymentMethod"
                                forceSelection="false"
                                selectedKey="{mContractManagement>/header/paymentMethod}"
                                items="{
        path: 'mContractManagement>/paymentMethods',
        templateShareable: false
    }"
                            >
                                <core:ListItem
                                    key="{mContractManagement>Zlsch}"
                                    text="{mContractManagement>Zlsch} - {mContractManagement>Text1}"
                                />
                            </Select>
                            <!-- Miguel Angel Fin: Método de pago -->

                            <!-- Miguel Angel Inicio: Condición de pago abajo de método de pago -->
                            <Label
                                text="{i18n>paymentTerms}"
                                required="true"
                            />
                            <Select
                                id="slPaymentTerms"
                                forceSelection="false"
                                selectedKey="{mContractManagement>/header/paymentTerms}"
                                items="{
        path: 'mContractManagement>/paymentTermsList',
        templateShareable: false
    }"
                            >
                                <core:ListItem
                                    key="{mContractManagement>Zterm}"
                                    text="{mContractManagement>Zterm} - {mContractManagement>Vtext}"
                                />
                            </Select>
                            <!-- Miguel Angel Fin: Condición de pago -->
                            <!-- se comenta lo de Área / Department
<Label text="{i180.n>department}" />
<Input enabled="false" value="{mContractManagement>/header/department}"/>
-->
                            <!-- Miguel Angel Fin: Condición de pago -->

                            <Label text="{i18n>validFromUntil}" />
                            <DateRangeSelection
                                valueHelpOnly="true"
                                dateValue="{mContractManagement>/header/validFromDate}"
                                secondDateValue="{mContractManagement>/header/validUntilDate}"
                            />
                            <Label text="{i18n>validFromUntilQuo}" />
                            <DateRangeSelection
                                valueHelpOnly="true"
                                dateValue="{mContractManagement>/header/validFromDateQuo}"
                                secondDateValue="{mContractManagement>/header/validUntilDateQuo}"
                            />
                            <Label text="{i18n>currency}" />
                            <Input
                                showValueHelp="true"
                                valueHelpOnly="true"
                                value="{mContractManagement>/header/oCurrency/CurrencyCode} {mContractManagement>/header/oCurrency/CurrencyName}"
                                valueHelpRequest="onOpenPopUpCurrency"
                            />
                        </form:content>
                    </form:SimpleForm>
                </Panel>
                <FlexBox
                    fitContainer="true"
                    renderType="Bare"
                    direction="Column"
                    height="100%"
                >
                    <Panel
                        expanded="true"
                        expandable="true"
                        stickyHeader="true"
                        height="100%"
                    >
                        <headerToolbar>
                            <OverflowToolbar active="true">
                                <Title
                                    text="{i18n>materials} ({= ${mContractManagement>/arrMaterial}.length })"
                                />
                                <ToolbarSpacer />
                                <Button
                                    text="{i18n>addMaterial}"
                                    press="addMaterial"
                                    type="Emphasized"
                                    icon="sap-icon://add"
                                />
                                <ToolbarSeparator />
                                <Button
                                    text="{i18n>assignEquipment}"
                                    press="onAssignEquipment"
                                    type="Attention"
                                    icon="sap-icon://add-product"
                                />
                                <Button
                                    press="onDeleteRow"
                                    type="Reject"
                                    icon="sap-icon://delete"
                                />
                            </OverflowToolbar>
                        </headerToolbar>
                        <content>
                            <t:Table
                                id="tblMaterial"
                                alternateRowColors="true"
                                busyIndicatorDelay="0"
                                enableColumnFreeze="true"
                                enableSelectAll="true"
                                enableColumnReordering="true"
                                showNoData="true"
                                selectionBehavior="RowSelector"
                                rowSelectionChange="onSelectRow"
                                rows="{mContractManagement>/arrMaterial}"
                                selectionMode="MultiToggle"
                            >
                                <t:layoutData>
                                    <FlexItemData
                                        growFactor="1"
                                        shrinkFactor="1"
                                    />
                                </t:layoutData>
                                <t:rowMode>
                                    <rowmodes:Auto />
                                </t:rowMode>
                                <t:columns>
                                    <t:Column
                                        width="20rem"
                                        hAlign="Center"
                                    >
                                        <Text text="{i18n>material}" />
                                        <t:template>
                                            <Input
                                                showValueHelp="true"
                                                valueHelpOnly="true"
                                                valueHelpRequest="onOpenPopUpMaterial"
                                                value="{path:'mContractManagement>oMaterial/Material'}"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="20rem">
                                        <Text text="{i18n>denomination}" />
                                        <t:template>
                                            <Text
                                                text="{path: 'mContractManagement>oMaterial/Description'}"
                                            />
                                        </t:template>
                                    </t:Column>

                                       


<t:Column width="12rem" hAlign="Center">
    <Text text="Destinatario" />
    <t:template>
        <ObjectStatus
            text="{= ${mContractManagement>arrPartners/0/Name} || 'Pendiente' }"
            state="{= ${mContractManagement>arrPartners}.length > 0 ? 'Success' : 'Warning' }"
            icon="sap-icon://supplier"
            press="onOpenPartnerManagement"
            active="true" />
    </t:template>
</t:Column>


                                    <t:Column width="13rem">
                                        <Text text="{i18n>cebe}" />
                                        <t:template>
                                            <Input
                                                showValueHelp="true"
                                                valueHelpOnly="true"
                                                valueHelpRequest="onOpenPopUpCebe"
                                                value="{path:'mContractManagement>oCebe/Profit'}"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="10rem">
                                        <Text text="{i18n>center}" />
                                        <t:template>
                                            <Select
                                                items="{ZSD_CATALOGOS_SRV>/PlantCodeSet}"
                                                showSecondaryValues="true"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedKeyCenter'}"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Plant}"
                                                    additionalText="{ZSD_CATALOGOS_SRV>Plant}"
                                                    text="{ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    <!--Miguel Angel se elimina la columna de Reason Order 09/03/2026
                                    <t:Column width="20rem">
                                        <Text text="{i18n>reasonOrder}"/>
                                        <t:template >
                                            <Input showValueHelp="true" valueHelpOnly="true"  valueHelpRequest="onOpenPopUpOrderReason"
                                                value="{path:'mContractManagement>oOrderReason/Reason'} - {path:'mContractManagement>oOrderReason/Description'}" 
                                            />
                                        </t:template>
                                    </t:Column>
                                    -->
                                    <t:Column width="9rem">
                                        <Text text="{i18n>netValue}" />
                                        <t:template>
                                            <Input
                                                value="{
                parts: [
                    {path: 'mContractManagement>netValue'},
                    {path: 'mContractManagement>/header/oCurrency/CurrencyCode'}
                ],
                type: 'sap.ui.model.type.Currency',
                formatOptions: {
                    showMeasure: false
                }
            }"
                                                editable="false"
                                                textAlign="End"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="13rem">
                                        <Text text="{i18n>workingHours}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem3Set'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedWorkingHours'}"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Name}"
                                                    text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    <!--comentado Por Miguel Angel para el tema de Materiales: El material y cobertura deben coincidir automaticamente  este fue cambiado por el de abajo -->
                                    <!--
                                    <t:Column width="10rem">
                                        <Text text="{i18n>customerGroup1}"/>
                                        <t:template >
                                            <Select items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem1Set'}"  forceSelection="false"  selectedKey="{path:'mContractManagement>selectedCustomerGroup1'}" >
                                                <core:ListItem key="{ZSD_CATALOGOS_SRV>Name}" text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"/>
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    -->
                                    <!--Miguel Angel Agregado Inicio  -->
                                    <t:Column width="10rem">
                                        <Text text="{i18n>customerGroup1}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem1Set'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedCustomerGroup1'}"
                                                enabled="{= !${mContractManagement>isCustomerGroup1Locked} }"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Name}"
                                                    text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>

                                    <!--Fin  -->

                                    <t:Column width="10rem">
                                        <Text text="{i18n>customerGroup3}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem2Set'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedCustomerGroup3'}"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Name}"
                                                    text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="10rem">
                                        <Text text="{i18n>customerGroup4}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem4Set'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedCustomerGroup4'}"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Name}"
                                                    text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="10rem">
                                        <Text text="{i18n>customerGroup5}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/GroMatItem5Set'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedCustomerGroup5'}"                                  
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Name}"
                                                    text="{ZSD_CATALOGOS_SRV>Name} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>

                                    <!-- Inicio de cambios Miguel Angel 06/03/2026 -->
                                    <t:Column width="12rem">
                                        <Text text="{i18n>usageType}" />
                                        <t:template>
                                            <Select
                                                items="{path : 'ZSD_CATALOGOS_SRV>/CustomerGroupSet'}"
                                                forceSelection="false"
                                                selectedKey="{path:'mContractManagement>selectedUsageType'}"
                                                change="onChangeUsageType"
                                            >
                                                <core:ListItem
                                                    key="{ZSD_CATALOGOS_SRV>Group}"
                                                    text="{ZSD_CATALOGOS_SRV>Group} - {ZSD_CATALOGOS_SRV>Description}"
                                                />
                                            </Select>
                                        </t:template>
                                    </t:Column>
                                    <!-- fin de cambios Miguel Angel  -->
                                    <t:Column
                                        width="6rem"
                                        visible="false"
                                    >
                                        <Text text="{i18n>paymentMethod}" />
                                        <t:template>
                                            <Text
                                                text="{path: 'mContractManagement>nameRecipient'}"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="15rem">
                                        <Text text="{i18n>validFromUntil}" />
                                        <t:template>
                                            <DateRangeSelection
                                                dateValue="{mContractManagement>validFromDate}"
                                                secondDateValue="{mContractManagement>validUntilDate}"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column width="12rem">
                                        <Text text="{i18n>assignedEquipment}" />
                                        <t:template>
                                            <Text
                                                text="{path: 'mContractManagement>arrEquipment/0/EquipmentB'}"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column
                                        width="6rem"
                                        hAlign="Center"
                                    >
                                        <Text text="{i18n>viewEquipment}" />
                                        <t:template>
                                            <Button
                                                enabled="{= ${mContractManagement>arrEquipment}.length > 0 }"
                                                press="showEquipment"
                                                icon="sap-icon://product"
                                            />
                                        </t:template>
                                    </t:Column>
                                    <t:Column
                                        width="6rem"
                                        hAlign="Center"
                                    >
                                        <Text text="{i18n>cup}" />
                                        <t:template>
                                            <Button
                                                enabled="{= ${mContractManagement>arrEquipment}.length > 0 }"
                                                press="showEquipment($event,true)"
                                                icon="sap-icon://machine"
                                            />
                                        </t:template>
                                    </t:Column>
                                </t:columns>
                                <t:Column
                                    width="6rem"
                                    hAlign="Center"
                                >
                                    <Text text="{i18n>copyItem}" />
                                    <t:template>
                                        <Button
                                            press=".onCopyItem"
                                            icon="sap-icon://copy"
                                            type="Transparent"
                                            tooltip="{i18n>copyItemTooltip}"
                                        />
                                    </t:template>
                                </t:Column>
                                <t:noData>
                                    <IllustratedMessage
                                        illustrationType="sapIllus-SimpleEmptyList"
                                        enableVerticalResponsiveness="true"
                                        title="{i18n>thereAreNotEntriesYet}"
                                        description="{i18n>thereAreNotEntriesYetDesc}"
                                    />
                                </t:noData>
                            </t:Table>
                        </content>
                    </Panel>
                </FlexBox>
            </FlexBox>
        </f:content>
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button
                    id="btnNext"
                    type="Accept"
                    text="{i18n>save}"
                    press="onSave"
                    icon="sap-icon://save"
                />
                <Button
                    type="Reject"
                    text="{i18n>clear}"
                    icon="sap-icon://clear-filter"
                    press="onClear"
                />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
