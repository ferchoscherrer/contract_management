<mvc:View controllerName="repairplanning.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:uxap="sap.uxap">

    <NavContainer id="navContainer">
        <!-- PÁGINA 1: Listado Jerárquico de Procesos -->
        <Page id="mainPage" title="Planificación de Mantenimiento - Ciclo de Vida">
            <content>
                <t:TreeTable
                    id="treeTable"
                    rows="{path: '/notifications', parameters: {arrayNames: ['nodes']}}"
                    toggleOpenState="onToggleOpenState"
                    selectionMode="Single"
                    enableSelectAll="false"
                    ariaLabelledBy="title">
                    <t:columns>
                        <t:Column label="Proceso / ID" width="270px">
                            <t:template>
                                <HBox alignItems="Center">
                                    <core:Icon src="{path: 'type', formatter: '.formatTypeIcon'}" class="sapUiTinyMarginEnd" />
                                    <Text text="{type}: {id}" />
                                </HBox>
                            </t:template>
                        </t:Column>

                        <!-- NUEVA: mini flujo de fases, solo en la fila del aviso -->
                        <t:Column label="Ciclo" width="150px">
                            <t:template>
                                <HBox visible="{= ${type} === 'Aviso'}"
                                      items="{path: 'phases', templateShareable: false}">
                                    <core:Icon src="{icon}" color="{color}" tooltip="{tooltip}"
                                               size="1rem" class="sapUiTinyMarginEnd" />
                                </HBox>
                            </t:template>
                        </t:Column>

                        <t:Column label="Descripción" width="250px">
                            <t:template>
                                <Text text="{description}" />
                            </t:template>
                        </t:Column>

                        <!-- El texto se arma en el controller (propiedad "detail"): sin más "undefined" -->
                        <t:Column label="Detalle Específico de la Fase" width="340px">
                            <t:template>
                                <Text text="{detail}" wrapping="true" />
                            </t:template>
                        </t:Column>

                        <t:Column label="Fecha" width="110px">
                            <t:template>
                                <Text text="{date}" />
                            </t:template>
                        </t:Column>

                        <t:Column label="Estado" width="180px">
                            <t:template>
                                <HBox alignItems="Center">
                                    <ObjectStatus
                                        visible="{= ${type} !== 'Requerimiento MRP' || ${mrpState} === 'WAITING' || ${mrpState} === 'PENDING_RUN'}"
                                        text="{status}" state="{statusState}" icon="{statusIcon}"
                                        tooltip="{status}" />
                                    <ProgressIndicator
                                        visible="{= ${type} === 'Requerimiento MRP' &amp;&amp; ${mrpState} === 'PLANNED'}"
                                        percentValue="{coverage}" displayValue="{coverageText}"
                                        state="{statusState}" width="160px" height="1.25rem"
                                        displayOnly="true" tooltip="{status}" />
                                </HBox>
                            </t:template>
                        </t:Column>

                        <t:Column label="Acción" width="250px">
                            <t:template>
                                <HBox visible="{= ${type} !== 'Loading'}">
                                    <Button text="Ver Detalle" icon="sap-icon://detail-view"
                                            press="onPressDetail" type="Emphasized" class="sapUiTinyMarginEnd" />
                                    <Button text="Correr MRP" icon="sap-icon://synchronize"
                                            press="onRunMrp" type="Attention"
                                            visible="{= ${type} === 'Requerimiento MRP' &amp;&amp; ${mrpState} === 'PENDING_RUN'}" />
                                </HBox>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:TreeTable>
            </content>
        </Page>

        <!-- PÁGINA 2: Vista de Detalle -->
        <Page id="detailPage" title="{path: 'type', formatter: '.formatDetailTitle'}" showNavButton="true" navButtonPress="onNavBack">
            <content>
                <uxap:ObjectPageLayout id="objectPageLayout" upperCaseAnchorBar="false">
                    <uxap:headerTitle>
                        <uxap:ObjectPageDynamicHeaderTitle>
                            <uxap:heading>
                                <Title text="{type} - {id}" wrapping="true"/>
                            </uxap:heading>
                            <uxap:snappedContent>
                                <Text text="{description}"/>
                            </uxap:snappedContent>
                        </uxap:ObjectPageDynamicHeaderTitle>
                    </uxap:headerTitle>
                    <uxap:headerContent>
                        <FlexBox wrap="Wrap" fitContainer="true">
                            <VBox class="sapUiMediumMarginEnd">
                                <Label text="Descripción del Registro"/>
                                <Text text="{description}"/>
                            </VBox>
                            <VBox class="sapUiMediumMarginEnd">
                                <Label text="Estado Actual"/>
                                <ObjectStatus text="{status}" state="{= ${statusState} || 'None'}" icon="{statusIcon}"/>
                            </VBox>
                            <VBox>
                                <Label text="Fecha de Registro"/>
                                <Text text="{date}"/>
                            </VBox>
                        </FlexBox>
                    </uxap:headerContent>
                    <uxap:sections>
                        <uxap:ObjectPageSection title="Información Específica del Objeto">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection title="Datos Técnicos y de Negocio">
                                    <uxap:blocks>
                                        <VBox>
                                            <VBox visible="{= ${type} === 'Aviso'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.AvisoDetail" type="XML" />
                                            </VBox>
                                            <VBox visible="{= ${type} === 'Orden de Manto'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.OrdenDetail" type="XML" />
                                            </VBox>
                                            <VBox visible="{= ${type} === 'Cotización'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.CotizacionDetail" type="XML" />
                                            </VBox>
                                            <!-- NUEVO: Liberación / Requerimiento MRP / Material -->
                                            <VBox visible="{= ${type} === 'Liberación' || ${type} === 'Requerimiento MRP' || ${type} === 'Material'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.SupplyDetail" type="XML" />
                                            </VBox>
                                            <VBox visible="{= ${type} === 'SCM'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.ScmDetail" type="XML" />
                                            </VBox>
                                            <VBox visible="{= ${type} === 'Factura'}">
                                                <core:Fragment fragmentName="repairplanning.view.fragment.detail.FacturaDetail" type="XML" />
                                            </VBox>
                                        </VBox>
                                    </uxap:blocks>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>
                    </uxap:sections>
                </uxap:ObjectPageLayout>
            </content>
        </Page>
    </NavContainer>
</mvc:View>
