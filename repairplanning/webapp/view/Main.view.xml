<mvc:View controllerName="repairplanning.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:t="sap.ui.table"
    xmlns:uxap="sap.uxap">
    
    <NavContainer id="navContainer">
        <!-- PÁGINA 1: Listado Jerárquico de Procesos -->
        <Page id="mainPage" title="Planificación de Mantenimiento - Ciclo de Vida">
            <content>
                <t:TreeTable
                    id="treeTable"
                    rows="{path: '/notifications', parameters: {arrayNames: ['nodes']}}"
                    toggleOpenState="onToggleOpenState"
                    selectionMode="Single"
                    enableSelectAll="false"
                    ariaLabelledBy="title">
                    <t:columns>
                        <!-- Columna de Tipo y ID con icono dinámico -->
                        <t:Column label="Proceso / ID" width="220px">
                            <t:template>
                                <HBox alignItems="Center">
                                    <core:Icon src="{= ${type} === 'Aviso' ? 'sap-icon://alert' : (${type} === 'Orden de Manto' ? 'sap-icon://eam-work-order' : (${type} === 'Cotización' ? 'sap-icon://request' : (${type} === 'SCM' ? 'sap-icon://shipping-status' : 'sap-icon://payment')))}" class="sapUiTinyMarginEnd" />
                                    <Text text="{type}: {id}" />
                                </HBox>
                            </t:template>
                        </t:Column>

                        <t:Column label="Descripción" width="260px">
                            <t:template>
                                <Text text="{description}" />
                            </t:template>
                        </t:Column>

                        <!-- Columna con Fragmentos dinámicos según la jerarquía -->
                        <t:Column label="Detalle Específico de la Fase" width="320px">
    <t:template>
        <Text text="{= 
            ${type} === 'Aviso' ? 'Prioridad: ' + ${priority} + ' | Equipo: ' + ${equipment} : 
            (${type} === 'Orden de Manto' ? 'Craft: ' + ${craft} + ' | Centro: ' + ${workCenter} : 
            (${type} === 'Cotización' ? 'Prov: ' + ${vendor} + ' (' + ${amount} + ')' : 
            (${type} === 'SCM' ? 'Guía: ' + ${trackingNumber} : 
            (${type} === 'Factura' ? 'Folio: ' + ${invoiceNum} + ' - Impuesto: ' + ${taxCode} : '')))) 
        }" wrapping="true" />
    </t:template>
</t:Column>

                        <t:Column label="Fecha" width="120px">
                            <t:template>
                                <Text text="{date}" />
                            </t:template>
                        </t:Column>

                        <t:Column label="Estado" class="sapUiTinyMarginBegin" width="130px">
                            <t:template>
                                <ObjectStatus text="{status}" 
    state="{statusState}" 
    icon="{statusIcon}" />
                            </t:template>
                        </t:Column>

                        <t:Column label="Acción" width="120px">
                            <t:template>
                                <Button text="Ver Detalle" icon="sap-icon://detail-view" press="onPressDetail" type="Emphasized"/>
                            </t:template>
                        </t:Column>
                    </t:columns>
                </t:TreeTable>
            </content>
        </Page>

        <!-- PÁGINA 2: Vista de Detalle (Object Page con Fragmentos por Jerarquía) -->
        <Page id="detailPage" title="{path: 'type', formatter: '.formatDetailTitle'}" showNavButton="true" navButtonPress="onNavBack">
            <content>
                <uxap:ObjectPageLayout id="objectPageLayout" upperCaseAnchorBar="false">
                    <uxap:headerTitle>
                        <uxap:ObjectPageDynamicHeaderTitle>
                            <uxap:heading>
                                <Title text="{type} - {id}" wrapping="true"/>
                            </uxap:heading>
                            <uxap:snappedContent>
                                <Text text="{description}"/>
                            </uxap:snappedContent>
                        </uxap:ObjectPageDynamicHeaderTitle>
                    </uxap:headerTitle>
                    <uxap:headerContent>
                        <FlexBox wrap="Wrap" fitContainer="true">
                            <VBox class="sapUiMediumMarginEnd">
                                <Label text="Descripción del Registro"/>
                                <Text text="{description}"/>
                            </VBox>
                            <VBox class="sapUiMediumMarginEnd">
                                <Label text="Estado Actual"/>
                                <ObjectStatus text="{status}" state="Success"/>
                            </VBox>
                            <VBox>
                                <Label text="Fecha de Registro"/>
                                <Text text="{date}"/>
                            </VBox>
                        </FlexBox>
                    </uxap:headerContent>
                    <uxap:sections>
                        <uxap:ObjectPageSection title="Información Específica del Objeto">
                            <uxap:subSections>
                                <uxap:ObjectPageSubSection title="Datos Técnicos y de Negocio">
                                   <uxap:blocks>
    <VBox>
        <VBox visible="{= ${type} === 'Aviso'}">
            <core:Fragment fragmentName="repairplanning.view.fragment.detail.AvisoDetail" type="XML" />
        </VBox>
        <VBox visible="{= ${type} === 'Orden de Manto'}">
            <core:Fragment fragmentName="repairplanning.view.fragment.detail.OrdenDetail" type="XML" />
        </VBox>
        <VBox visible="{= ${type} === 'Cotización'}">
            <core:Fragment fragmentName="repairplanning.view.fragment.detail.CotizacionDetail" type="XML" />
        </VBox>
        <VBox visible="{= ${type} === 'SCM'}">
            <core:Fragment fragmentName="repairplanning.view.fragment.detail.ScmDetail" type="XML" />
        </VBox>
        <VBox visible="{= ${type} === 'Factura'}">
            <core:Fragment fragmentName="repairplanning.view.fragment.detail.FacturaDetail" type="XML" />
        </VBox>
    </VBox>
</uxap:blocks>
                                </uxap:ObjectPageSubSection>
                            </uxap:subSections>
                        </uxap:ObjectPageSection>
                    </uxap:sections>
                </uxap:ObjectPageLayout>
            </content>
        </Page>
    </NavContainer>
</mvc:View>